{
  "name": "janusgraph-desktop-workspace",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@8.11.0",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @janusgraph/desktop start",
    "build": "pnpm --filter @janusgraph/desktop package",
    "make": "pnpm --filter @janusgraph/desktop make",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:compat": "node tests/compat/run.mjs",
    "test:e2e": "node tests/e2e/packaged-smoke.mjs",
    "i18n:generate": "node scripts/generate-i18n.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "release:checksums": "node scripts/release-metadata.mjs"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  },
  "pnpm": {
    "overrides": {
      "@electron/rebuild>@electron/node-gyp": "10.2.0-electron.2"
    }
  }
}
